# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=
MONGODB_DATABASE=roborally
SESSION_SECRET=
# Local dev runs over plain http://localhost, where browsers reject
# Secure cookies: keep this false locally or login sessions will
# silently not persist. Set true in production (HTTPS).
SESSION_COOKIE_SECURE=false
# Meta Model API key from https://dev.meta.ai/ dashboard.
# META_API_KEY is accepted as a deprecated alias.
MODEL_API_KEY=
# Comma-separated CORS origins for credentialed browser requests.
# Leave commented for local dev (defaults to http://localhost:3000);
# production must set the exact deployed frontend origin (never "*").
# FRONTEND_ORIGINS=
