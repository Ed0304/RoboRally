# Copy to .env and fill in real values. Never commit .env.
# API base for backend calls. Leave empty for same-origin through the
# Next.js /api rewrite (local dev and production default); set an
# absolute backend origin, without a trailing slash, only for
# deployments without the proxy. Rebuild after any change here:
# NEXT_PUBLIC_* values bake into the client bundle at build time.
NEXT_PUBLIC_API_URL=
# Backend origin for the Next.js /api rewrite. Server-side only, but
# resolved when the frontend is built: rebuild after changing it.
BACKEND_INTERNAL_URL=http://localhost:8000
# Used only by scripts/seed-levels.ts (dev-only database seeding),
# never by the browser.
MONGODB_URI=
MONGODB_DB=roborally
